# AI Provider Configuration
# Options: 'openai', 'anthropic', 'windsurf'
AI_PROVIDER=openai

# AI API Key
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
AI_API_KEY=your_api_key_here

# AI Model (optional, uses provider defaults if not set)
# OpenAI: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-opus-20240229
AI_MODEL=gpt-4

# GitHub Personal Access Token
# Get from: https://github.com/settings/tokens
# Required scopes: repo, workflow
GITHUB_TOKEN=your_github_token_here

# Base URL for tests (optional)
BASE_URL=http://localhost:8000

# Jira (optional). When set, npm start creates Jira issues for test failures and updates the board via API.
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_atlassian_api_token
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
# JIRA_ISSUE_TYPE=Bug
